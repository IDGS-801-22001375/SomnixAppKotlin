<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_button_glass"
            android:contentDescription="Menú"
            android:elevation="3dp"
            android:padding="11dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#073B67" />

        <!-- Sustituye somnix_logo por tu PNG del logo en res/drawable. -->
        <ImageView
            android:id="@+id/imgLogoSomnix"
            android:layout_width="154dp"
            android:layout_height="58dp"
            android:adjustViewBounds="true"
            android:contentDescription="Somnix"
            android:scaleType="fitCenter"
            android:src="@drawable/somnix_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Dashboard de monitoreo"
            android:textColor="#09213A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoSomnix" />

        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_active"
            android:drawableStart="@drawable/ic_status_dot"
            android:drawablePadding="7dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp"
            android:text="Activo"
            android:textColor="#067A72"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/txtSubtitulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtSubtitulo" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrincipal"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
            app:strokeColor="#4D7FDFFF"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ambiente automovilístico nocturno"
                    android:scaleType="centerCrop"
                    android:src="@drawable/card_route_background" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_route_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Ruta actual"
                        android:textColor="#BFE9FF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtRutaActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Sin ruta activa"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFatiga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Fatiga detectada: 0%"
                        android:textColor="#E6F5FF"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/progressFatiga"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="9dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_fatigue_neon" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEmpezarRuta"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_neon"
            android:elevation="5dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Empezar ruta"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPrincipal" />

        <TextView
            android:id="@+id/txtAccesos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="Accesos rápidos"
            android:textColor="#09213A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEmpezarRuta" />

        <GridLayout
            android:id="@+id/gridOpciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtAccesos">

            <LinearLayout
                android:id="@+id/cardMisRutas"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_glass_blue"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_cyan"
                    android:padding="8dp"
                    android:src="@drawable/ic_route"
                    app:tint="#009DB8" />

                <TextView
                    style="@style/SomnixQuickAccessText"
                    android:text="Mis rutas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEstadisticas"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_glass_violet"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_blue"
                    android:padding="8dp"
                    android:src="@drawable/ic_statistics"
                    app:tint="#1769E8" />

                <TextView
                    style="@style/SomnixQuickAccessText"
                    android:text="Estadísticas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardCamara"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_card_glass_cyan"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_cyan"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera"
                    app:tint="#009DB8" />

                <TextView
                    style="@style/SomnixQuickAccessText"
                    android:text="Monitoreo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAlertas"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_card_glass_violet"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_violet"
                    android:padding="8dp"
                    android:src="@drawable/ic_alert"
                    app:tint="#7257E7" />

                <TextView
                    style="@style/SomnixQuickAccessText"
                    android:text="Alertas" />
            </LinearLayout>
        </GridLayout>

        <LinearLayout
            android:id="@+id/cardUltimaAlerta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_glass_blue"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridOpciones">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Última alerta"
                android:textColor="#09213A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtUltimaAlerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No hay alertas recientes"
                android:textColor="#60758A"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
