<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:paddingStart="20dp"
    android:paddingTop="60dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp"
    tools:context=".MonitoreoActivity">

    <!-- CABECERA -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="Regresar"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#071F3D" />

    <LinearLayout
        android:id="@+id/contenedorTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/txtEstadoMonitoreo"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <TextView
            android:id="@+id/txtTituloMonitoreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoreo"
            android:textColor="#071F3D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloMonitoreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control del viaje"
            android:textColor="#667085"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtEstadoMonitoreo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_dark"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="Inactivo"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- RUTA Y CONEXIÓN -->

    <LinearLayout
        android:id="@+id/cardRuta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Ruta actual"
            android:padding="9dp"
            android:src="@drawable/ic_route"
            app:tint="#071F3D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta actual"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRutaMonitoreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sin ruta activa"
                android:textColor="#071F3D"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtConexionGorra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pendiente"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Sin gorra"
            android:textColor="#7A4D00"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CÁMARA -->

    <FrameLayout
        android:id="@+id/cardCamaraMonitoreo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_dark"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/txtUltimasAlertas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="180dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardRuta">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewCamara"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_dark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Cámara frontal"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtNivelAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_dark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Bajo"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtPorcentajeFatiga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fatiga: 0%"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEstadoConductor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Estado: normal"
                android:textColor="#DDE7F3"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- ÚLTIMA ALERTA -->

    <TextView
        android:id="@+id/txtUltimasAlertas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No hay alertas recientes"
        android:textColor="#667085"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/cardAccionesViaje"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BOTONES FIJOS -->

    <LinearLayout
        android:id="@+id/cardAccionesViaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- VIAJE INACTIVO -->

        <LinearLayout
            android:id="@+id/contenedorAccionesIniciales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConfigurar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#E7EEF7"
                android:text="Conectar"
                android:textAllCaps="false"
                android:textColor="#071F3D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIniciarViaje"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#071F3D"
                android:text="Iniciar viaje"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- VIAJE ACTIVO -->

        <LinearLayout
            android:id="@+id/contenedorAccionesActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPausarViaje"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFF3CD"
                    android:text="Pausar"
                    android:textAllCaps="false"
                    android:textColor="#7A4D00"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTerminarViaje"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFE8E8"
                    android:text="Terminar"
                    android:textAllCaps="false"
                    android:textColor="#B42318"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnApagarAlarma"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#071F3D"
                android:text="Apagar alarmas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- VIAJE PAUSADO -->

        <LinearLayout
            android:id="@+id/contenedorAccionesPausado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReanudarViaje"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DFF8E8"
                    android:text="Reanudar"
                    android:textAllCaps="false"
                    android:textColor="#05603A"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTerminarViajePausado"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFE8E8"
                    android:text="Terminar"
                    android:textAllCaps="false"
                    android:textColor="#B42318"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnApagarAlarmaPausado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E7EEF7"
                android:text="Apagar alarmas"
                android:textAllCaps="false"
                android:textColor="#071F3D"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>